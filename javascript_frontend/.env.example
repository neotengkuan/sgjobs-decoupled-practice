# Base URL of the SGJobs FastAPI backend.
#
# http://localhost:8000  -> the browser calls the API cross-origin.
#                           This requires CORS on the backend.
#
# (empty)                  -> the browser calls "/api/..." on the Vite dev
#                           server, which proxies to the backend.
#                           No CORS needed, no backend change.
#
# See README.md for the exact CORS snippet if you use the direct mode.
VITE_API_URL=http://localhost:8000